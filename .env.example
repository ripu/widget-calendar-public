# Indirizzo segreto in formato iCal del calendario Google.
# Google Calendar → Impostazioni → (il tuo calendario) → Integra calendario
# → "Indirizzo segreto in formato iCal". Più calendari: separali con la virgola.
ICAL_URL=https://calendar.google.com/calendar/ical/XXXX/private-XXXX/basic.ics

# Altri calendari (es. quello personale): ICAL_URL_2, ICAL_URL_3, …
# Gli eventi presenti in più calendari (stesso invito) compaiono una volta sola.
ICAL_URL_2=

# Giorni mostrati a partire da oggi
DAYS=7

# Ogni quanti minuti riscaricare il calendario
REFRESH_MIN=5
